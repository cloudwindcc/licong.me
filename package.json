{
  "name": "academic-profile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-paper-pages.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/finalize-site.mjs && node scripts/audit-seo.mjs",
    "check:seo": "node scripts/audit-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:papers": "node scripts/generate-paper-pages.mjs",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^2.12.0",
    "tsparticles-slim": "^2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fast-xml-parser": "^5.11.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.4.2"
  }
}
